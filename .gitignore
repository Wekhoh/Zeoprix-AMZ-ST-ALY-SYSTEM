# ===================
# 数据文件（敏感）
# ===================
*.db
*.sqlite
*.sqlite3
data/db/*.db
data/db/*.sqlite
data/db/*.sqlite3
data/uploads/*
!data/uploads/.gitkeep
!data/db/.gitkeep

# ===================
# 导出文件
# ===================
exports/

# ===================
# 会话/计划工件
# ===================
findings.md
progress.md
task_plan.md

# ===================
# 日志文件
# ===================
*.log
# 用 logs/* 而非 logs/ —— git 不允许 negation 重收 ignored parent dir 内的子文件，
# 所以需要 ignore 内容而非整个 directory
logs/*
# 例外：验证报告 (verification-report-*.md) 是设计交付物，需要入库
!logs/verification-report-*.md

# ===================
# 测试和覆盖率
# ===================
.pytest_cache/
.pytest_tmp/
.coverage
htmlcov/
.tox/
.nox/

# ===================
# Streamlit
# ===================
.streamlit/secrets.toml

# ===================
