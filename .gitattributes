# Auto detect text files and normalize line endings
* text=auto

# Python files always use LF
*.py text eol=lf

# Markdown and config files use LF
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.csv text eol=lf

# Shell scripts
*.sh text eol=lf

# Windows scripts
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.db binary
*.xlsx binary
*.xls binary
*.png binary
*.jpg binary
*.gif binary
